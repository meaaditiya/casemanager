
# Blockchain Core Settings
BLOCKCHAIN_SECRET=your-super-secret-key-change-this-in-production
BLOCKCHAIN_NETWORK_ID=ecourt-network-v3
BLOCKCHAIN_DIFFICULTY=4

# RSA Key Paths (for digital signatures)
RSA_PRIVATE_KEY_PATH=./blockchain/keys/private.pem
RSA_PUBLIC_KEY_PATH=./blockchain/keys/public.pem

# IPFS Settings (Optional but recommended)
ENABLE_IPFS=true
IPFS_HOST=ipfs.infura.io
IPFS_PORT=5001
IPFS_PROTOCOL=https
IPFS_GATEWAY=https://ipfs.io/ipfs/
# For Infura IPFS (get free account at infura.io)
# IPFS_AUTH=Basic <base64_encoded_project_id:secret>

# 🆕 OpenTimestamps Settings (FREE - Bitcoin-backed timestamps)
ENABLE_TIMESTAMP=true
# No API key needed - uses public Bitcoin blockchain

# Security Settings
NODE_ENV=production
PORT=5000


# ========================================
# SETUP INSTRUCTIONS
# ========================================
# 1. Copy this file to .env: cp .env.example .env
# 2. Generate RSA keys: node blockchain/utils/generateKeys.js
# 3. Change BLOCKCHAIN_SECRET to a strong random value
# 4. (Optional) Sign up for Infura IPFS and add credentials
# 5. Never commit .env or private.pem to git!